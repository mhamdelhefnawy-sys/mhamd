# SQLite by default (zero-config for dev/demo). Swap for a Postgres URL in production —
# the schema uses portable types only, see docs/DEPLOYMENT.md.
DATABASE_URL="file:./dev.db"

# Random 32+ char secret used to sign session cookies (jose/HS256).
AUTH_SECRET="change-this-to-a-long-random-string-in-production"

NODE_ENV="development"
