DATABASE_URL="postgresql://ccc:ccc_dev_password@localhost:5432/ccc?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000

# NODE_ENV=production enforces production hardening at startup:
#  - JWT_SECRET is required (the app refuses to start without one)
#  - CORS fails closed (blocks all origins) unless ALLOWED_ORIGINS is set below
# NODE_ENV=production

# Comma-separated list of origins allowed to call this API in production, e.g.:
# ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# For heavy concurrent load, tune Prisma's connection pool via the DATABASE_URL
# query string, e.g. "...?schema=public&connection_limit=20&pool_timeout=20"
# and size it against your Postgres max_connections and expected concurrent users.
